# Server-only configuration. Never expose these values in the browser.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=order_manager

# Firebase project ID. Must match the web app's Firebase project.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional Firebase Admin credentials. ID-token signature verification works
# without them. Providing a service account also enables Firebase token
# revocation checks. Provide ONE option, or set GOOGLE_APPLICATION_CREDENTIALS.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Server-only: the Firebase Authentication UID of the owner's first admin account.
# On that account's first verified authenticated visit it becomes an approved administrator.
BOOTSTRAP_ADMIN_UID=your-firebase-uid

# Comma-separated browser origins allowed to call the API. Use * to allow all.
# Same-origin requests are always allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Set to false when hosting the built web app separately from the API.
SERVE_WEB=true
